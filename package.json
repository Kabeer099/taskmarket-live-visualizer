{
  "name": "taskmarket-live-visualizer",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Public, server-cached live market visualizer for Taskmarket (Tempo OUSD & Base USDC) following the official Taskmarket Brand Kit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
